# Copy to .env locally; never commit .env or real secrets.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./disasterguard.db
FRONTEND_ORIGINS=http://localhost:5173
DISASTERGUARD_MODEL_PATH=

# Ollama is the only assistant provider; failures do not fall back to a cloud service.
DISASTERGUARD_ASSISTANT_PROVIDER=ollama
DISASTERGUARD_ASSISTANT_BASE_URL=http://localhost:11434/v1
DISASTERGUARD_ASSISTANT_MODEL=qwen2.5:3b
DISASTERGUARD_ASSISTANT_TIMEOUT_SECONDS=120

# The default monitored location; override with your study-site coordinates.
WEATHER_LOCATION_NAME=Kochi
WEATHER_LATITUDE=9.9312
WEATHER_LONGITUDE=76.2673
# Poll schedule, not a promise that Open-Meteo publishes a new observation each poll.
WEATHER_POLL_INTERVAL_SECONDS=60
# Two hours accommodates delayed model updates while still marking old observations stale.
WEATHER_MAX_AGE_SECONDS=7200
# Optional JSON array of {name, latitude, longitude} objects for multiple locations.
WEATHER_LOCATIONS_JSON=

# Copernicus Data Space OAuth client credentials (backend only).
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Public NWDP CKAN telemetry collector; no API key is required for these public resources.
HYDROLOGY_POLL_INTERVAL_SECONDS=60
HYDROLOGY_STALE_AFTER_HOURS=6
NWDP_OBSERVATION_TIMEZONE=Asia/Kolkata
NWDP_API_BASE_URL=https://nwdp.nwic.gov.in/api/3/action
NWDP_OBSERVATION_TIMEZONE=Asia/Kolkata
NWDP_CWC_KRISHNA_WATER_LEVEL_RESOURCE_ID=
NWDP_CWC_ANDHRA_RAINFALL_RESOURCE_ID=
NWDP_PAGE_SIZE=1000
NWDP_MAX_PAGES_PER_CYCLE=64
NWDP_TIMEOUT_SECONDS=20
